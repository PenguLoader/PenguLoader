<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Debug builds produce a console-subsystem exe so logs are visible in a terminal.
         Release ships as a windowed exe with no allocated console. -->
		<OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
		<OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>Pengu.Windows</RootNamespace>
		<AssemblyName>Pengu</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>app-icon.ico</ApplicationIcon>
		<!-- The head is an exe, not a NuGet package. PackageId would otherwise
         default to AssemblyName ("Pengu") and collide with the core lib's
         package. -->
		<IsPackable>false</IsPackable>
		<PackageId>Pengu.WindowsHead</PackageId>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pengu\Pengu.csproj" />
		<ProjectReference Include="..\Pengu.Gen\Pengu.Gen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="WebView2.NativeAssets.Win32" Version="1.0.1518.46" />
		<PackageReference Include="Diga.WebView2.Interop.AOT" Version="1.0.4-preview" />
		<PackageReference Include="Vanara.PInvoke.Kernel32" Version="5.0.0" />
		<PackageReference Include="Vanara.PInvoke.User32" Version="5.0.0" />
		<PackageReference Include="Vanara.PInvoke.DwmApi" Version="5.0.0" />
	</ItemGroup>

	<!-- Hub bundle: Release-only. Build packages/hub/dist/ → app.dat → embed
       it as a managed resource so the AOT-published Pengu.exe contains the
       hub UI in-binary. AppDat.OpenEmbedded reads it back at runtime. No
       app.dat ships alongside the exe.

       Two pieces, intentionally split:

       1. Static <EmbeddedResource> ItemGroup: declared at project-eval time
          so the SDK's CreateManifestResourceNames target sees it (that
          target runs as a dependency of CoreCompile, BEFORE any
          BeforeTargets="CoreCompile" target fires). The file path may not
          exist at project-load — csc only reads the file later, during
          CoreCompile itself. As long as BuildHubBundle has produced it by
          then, the bytes get embedded.

       2. BuildHubBundle target: BeforeTargets="BeforeBuild" so it runs at
          the very start of the build phase, before CoreCompile (and before
          CreateManifestResourceNames). Generates the file via pnpm + zip.
          MakeDir handles the case where IntermediateOutputPath doesn't
          exist on a clean build. -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<EmbeddedResource Include="$(IntermediateOutputPath)app.dat" LogicalName="app.dat" Visible="false" />
	</ItemGroup>

	<!-- Stage the native payload next to Pengu.exe when the ProjectReferences
       below are switched off.

       The host resolves core.dll from its own directory (IHost.CoreModulePath)
       and looks for boot.dll there when activation needs to install the boot,
       so a SkipNativeBuild build would otherwise have nothing to activate with
       even though the binaries are sitting in the C++ output directories.

       Platform is hardcoded to x64 rather than $(Platform): this project is
       AnyCPU with a win-x64 RID, while the vcxproj OutDir keys off its own
       $(Platform), and x64 is the only configuration either C++ project
       defines.

       Conditioned on existence rather than declared as a dependency: a
       `dotnet build` with no C++ toolchain present should still produce a
       runnable host, just one that can't activate. -->
	<Target Name="StageNativePayload" AfterTargets="Build" Condition="'$(SkipNativeBuild)' == 'true'">
		<ItemGroup>
			<_PenguNative Include="$(MSBuildThisFileDirectory)..\..\core\bin\x64\$(Configuration)\core.dll" />
			<_PenguNative Include="$(MSBuildThisFileDirectory)..\..\core\bin\x64\$(Configuration)\boot.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_PenguNative)" DestinationFolder="$(OutDir)" Condition="Exists('%(_PenguNative.FullPath)')" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="BuildHubBundle" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
		<Message Importance="high" Text="Pengu: building hub bundle (pnpm)" />
		<Exec Command="pnpm --filter @pengujs/hub build" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)..\..\packages\hub\dist" DestinationFile="$(IntermediateOutputPath)app.dat" Overwrite="true" />
	</Target>

	<ItemGroup Condition="'$(SkipNativeBuild)' != 'true'">
		<ProjectReference Include="..\..\core\boot\boot.vcxproj">
			<Private>true</Private>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Content</OutputItemType>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</ProjectReference>
		<ProjectReference Include="..\..\core\core.vcxproj">
			<Private>true</Private>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Content</OutputItemType>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</ProjectReference>
	</ItemGroup>

</Project>
