<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Debug builds produce a console-subsystem exe so logs are visible in a terminal.
         Release ships as a windowed exe with no allocated console. -->
		<OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
		<OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>Pengu.Windows</RootNamespace>
		<AssemblyName>Pengu</AssemblyName>
		<ApplicationManifest>Properties\app.manifest</ApplicationManifest>
		<ApplicationIcon>app-icon.ico</ApplicationIcon>
		<!-- The head is an exe, not a NuGet package. PackageId would otherwise
         default to AssemblyName ("Pengu") and collide with the core lib's
         package. -->
		<IsPackable>false</IsPackable>
		<PackageId>Pengu.WindowsHead</PackageId>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <InvariantGlobalization>true</InvariantGlobalization>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <EventSourceSupport>false</EventSourceSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <OptimizationPreference>Size</OptimizationPreference>
        <StackTraceSupport>false</StackTraceSupport>
	</PropertyGroup>

	<!-- Statically link the WebView2 loader so nothing ships beside Pengu.exe.
       See https://learn.microsoft.com/microsoft-edge/webview2/how-to/static —
       that page documents the C++ WebView2LoaderPreference=Static property,
       which lives in Microsoft.Web.WebView2.targets and only applies to a
       vcxproj. The NativeAOT equivalent is these two items:

       DirectPInvoke tells ILC to emit a direct call to the entrypoint instead
       of the lazy LoadLibrary("WebView2Loader.dll") + GetProcAddress cell it
       generates by default, which is what makes the symbol a link-time
       reference. NativeLibrary then puts the static archive on the link line
       to satisfy it. Both are required — DirectPInvoke alone gives an
       unresolved external, NativeLibrary alone leaves the P/Invoke looking
       for a DLL at runtime.

       WebView2LoaderStatic.lib asks for uuid.lib (for the CLSIDs it resolves)
       on top of the ole32.lib ILC already links; it declares no CRT of its
       own, so it inherits NativeAOT's without conflict.

       The x64 here tracks $(RuntimeIdentifier): the package lays its natives
       out as build\native\{x64,x86,arm64}, which is exactly the RID minus the
       "win-" prefix, so this follows automatically if the head ever targets
       another architecture.

       Trade-off: the loader can no longer be serviced independently of the
       exe. It is a ~160 KB shim whose whole job is locating the installed
       Evergreen runtime, and that lookup is what gets serviced, so this
       mostly costs us a rebuild if Microsoft ships a loader fix. -->
	<ItemGroup>
		<DirectPInvoke Include="WebView2Loader" />
		<NativeLibrary Include="$(PkgMicrosoft_Web_WebView2)\build\native\$(RuntimeIdentifier.Substring(4))\WebView2LoaderStatic.lib" />
		<NativeLibrary Include="uuid.lib" />
	</ItemGroup>

	<!-- ...but only a published build is AOT. `dotnet build -c Debug` produces a
       managed exe on CoreCLR, where DirectPInvoke and NativeLibrary do nothing
       and the [LibraryImport] above resolves WebView2Loader.dll the ordinary
       way — by name, from the exe directory, on first call. ExcludeAssets
       stopped the package staging it, so put it back for Debug.

       A copy rather than a conditional ExcludeAssets because PackageReference
       metadata is baked into project.assets.json at restore time, and restore
       runs once for all configurations: conditioning it would let a restore
       done in one configuration decide what a build in the other gets. -->
	<Target Name="StageWebView2Loader" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\runtimes\$(RuntimeIdentifier)\native\WebView2Loader.dll"
		      DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>

	<!-- ILC takes substitutions only as a raw argument, and the response file is
       written by WriteIlcRspFileForCompilation — hooking IlcCompile is too
       late, the argument would land after the file is already on disk. Verify
       with: findstr substitution obj\Release\native\Pengu.ilc.rsp.
       See ILLink.Substitutions.xml for what is being substituted and why. -->
	<Target Name="AddIlcSubstitutions" BeforeTargets="WriteIlcRspFileForCompilation">
		<ItemGroup>
			<IlcArg Include="--substitution:$(MSBuildProjectDirectory)\Properties\ILLink.Substitutions.xml" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\Pengu\Pengu.csproj" />
		<ProjectReference Include="..\Pengu.Gen\Pengu.Gen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- Loader only. ExcludeAssets=all keeps every managed asset out (the
         WPF / WinForms / Core assemblies assume a UI framework we don't use —
         Diga.WebView2.Interop.AOT supplies the COM types instead) and, more to
         the point, stops the native runtimes\win-x64\WebView2Loader.dll from
         being copied next to the exe. We take one file out of the package by
         hand: WebView2LoaderStatic.lib, linked in below.
         GeneratePathProperty gives us $(PkgMicrosoft_Web_WebView2) to find it,
         which is the only reason the reference exists at all. -->
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51"
		                  ExcludeAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="Diga.WebView2.Interop.AOT" Version="1.0.4-preview" />
		<PackageReference Include="Vanara.PInvoke.Kernel32" Version="5.0.0" />
		<PackageReference Include="Vanara.PInvoke.User32" Version="5.0.0" />
		<PackageReference Include="Vanara.PInvoke.DwmApi" Version="5.0.0" />
	</ItemGroup>

	<!-- Hub bundle: Release-only. Build packages/hub/dist/ → app.dat → embed
       it as a managed resource so the AOT-published Pengu.exe contains the
       hub UI in-binary. AppDat.OpenEmbedded reads it back at runtime. No
       app.dat ships alongside the exe.

       Two pieces, intentionally split:

       1. Static <EmbeddedResource> ItemGroup: declared at project-eval time
          so the SDK's CreateManifestResourceNames target sees it (that
          target runs as a dependency of CoreCompile, BEFORE any
          BeforeTargets="CoreCompile" target fires). The file path may not
          exist at project-load — csc only reads the file later, during
          CoreCompile itself. As long as BuildHubBundle has produced it by
          then, the bytes get embedded.

       2. BuildHubBundle target: BeforeTargets="BeforeBuild" so it runs at
          the very start of the build phase, before CoreCompile (and before
          CreateManifestResourceNames). Generates the file via pnpm + zip.
          MakeDir handles the case where IntermediateOutputPath doesn't
          exist on a clean build. -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<EmbeddedResource Include="$(IntermediateOutputPath)app.dat" LogicalName="app.dat" Visible="false" />
	</ItemGroup>

	<!-- Stage the native payload next to Pengu.exe when the ProjectReferences
       below are switched off.

       The host resolves core.dll from its own directory (IHost.CoreModulePath)
       and looks for boot.dll there when activation needs to install the boot,
       so a SkipNativeBuild build would otherwise have nothing to activate with
       even though the binaries are sitting in the C++ output directories.

       Platform is hardcoded to x64 rather than $(Platform): this project is
       AnyCPU with a win-x64 RID, while the vcxproj OutDir keys off its own
       $(Platform), and x64 is the only configuration either C++ project
       defines.

       Conditioned on existence rather than declared as a dependency: a
       `dotnet build` with no C++ toolchain present should still produce a
       runnable host, just one that can't activate. -->
	<Target Name="StageNativePayload" AfterTargets="Build" Condition="'$(SkipNativeBuild)' == 'true'">
		<ItemGroup>
			<_PenguNative Include="$(MSBuildThisFileDirectory)..\..\core\bin\x64\$(Configuration)\core.dll" />
			<_PenguNative Include="$(MSBuildThisFileDirectory)..\..\core\bin\x64\$(Configuration)\boot.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_PenguNative)" DestinationFolder="$(OutDir)" Condition="Exists('%(_PenguNative.FullPath)')" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="BuildHubBundle" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
		<Message Importance="high" Text="Pengu: building hub bundle (pnpm)" />
		<Exec Command="pnpm --filter @pengujs/hub build" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)..\..\packages\hub\dist" DestinationFile="$(IntermediateOutputPath)app.dat" Overwrite="true" />
	</Target>

	<ItemGroup Condition="'$(SkipNativeBuild)' != 'true'">
		<ProjectReference Include="..\..\core\boot\boot.vcxproj">
			<Private>true</Private>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Content</OutputItemType>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</ProjectReference>
		<ProjectReference Include="..\..\core\core.vcxproj">
			<Private>true</Private>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Content</OutputItemType>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</ProjectReference>
	</ItemGroup>

</Project>
