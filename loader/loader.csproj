<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<RootNamespace>Pengu.Loader</RootNamespace>

		<OutputPath>../bin/$(Configuration)/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Label="version-info">
		<Title>Pengu Loader</Title>
		<Company>GitHub, Inc.</Company>
		<Product>$(Title)</Product>
		<Description>$(Title) Application</Description>
		<Copyright>Copyright (c) Pengu Loader</Copyright>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(Version)</AssemblyVersion>
	</PropertyGroup>

	<PropertyGroup Label="aot-compatible">
		<DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<BuiltInComInteropSupport>false</BuiltInComInteropSupport>
		<DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
		<InvariantGlobalization>false</InvariantGlobalization>

		<PublishTrimmed>true</PublishTrimmed>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Label="aot-release" Condition="'$(Configuration)'=='Release'">
		<OutputType>Library</OutputType>
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<OptimizationPreference>Size</OptimizationPreference>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CsToml" Version="1.8.0" />
		<PackageReference Include="CsToml.Generator" Version="1.8.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MimeTypes" Version="2.5.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Websocket.Client" Version="5.3.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
		<PackageReference Include="ZLogger" Version="2.5.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\loader_v\loader_v.vcxproj">
			<Private>true</Private>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Content</OutputItemType>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="../loader_ui/dist/**" Visible="false" LogicalName="WebAssets/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
	</ItemGroup>

</Project>